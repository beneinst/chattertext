      [],
      0.0,
      null,
      null,
      1.0
    ],
    [
      "Lungo la strada incontra la chiesa di San Damiano,\ncadente e bisognosa di aiuto.\nVi entra e offre il denaro al sacerdote,\nraccontandogli il suo nuovo proposito.",
      "v1",
      "calmo",
